, {"level": "HSK1", "cn": "天气真好。", "py": "Tiānqì zhēn hǎo.", "en": "The weather is really nice."}, {"level": "HSK2", "cn": "没想到这次旅行真的这么难忘，让人流连忘返。", "py": "Méi xiǎngdào zhè cì lǚxíng zhēnde zhème nánwàng, ràng rén liúlián-wàngfǎn.", "en": "I didn't expect this trip to be so unforgettable, it makes you want to stay."}, {"level": "HSK2", "cn": "他的努力真让人佩服，值得我们学习。", "py": "Tā de nǔlì zhēn ràng rén pèifú, zhíde wǒmen xuéxí.", "en": "His hard work is truly admirable, worth learning from."}]}, {"id": 314, "level": "HSK2", "chinese": "正在", "pinyin": "zhèngzài", "english": "in the process of (doing)", "khmer": "កំពុងតែ", "breakdown": "正(exactly)+在(at)", "ex_cn": "我正在学习。", "ex_py": "Wǒ zhèngzài xuéxí.", "ex_en": "I am studying right now.", "chars": ["正", "在"], "examples": [{"level": "HSK1", "cn": "我正在学习。", "py": "Wǒ zhèngzài xuéxí.", "en": "I am studying right now."}, {"level": "HSK1", "cn": "他正在吃饭。", "py": "Tā zhèngzài chīfàn.", "en": "He is eating right now."}, {"level": "HSK1", "cn": "我们正在等你。", "py": "Wǒmen zhèngzài děng nǐ.", "en": "We are waiting for you."}, {"level": "HSK2", "cn": "他正在为下个月的考试做准备，每天学习到很晚。", "py": "Tā zhèngzài wèi xià ge yuè de kǎoshì zuò zhǔnbèi, měitiān xuéxí dào hěn wǎn.", "en": "He is preparing for next month's exam, studying late every day."}, {"level": "HSK2", "cn": "这个项目正在顺利进行，预计下周就能完成。", "py": "Zhège xiàngmù zhèngzài shùnlì jìnxíng, yùjì xià zhōu jiù néng wánchéng.", "en": "This project is proceeding smoothly and is expected to finish next week."}]}, {"id": 315, "level": "HSK2", "chinese": "知道", "pinyin": "zhīdào", "english": "know", "khmer": "ដឹង", "breakdown": "知(know)+道(way/principle)", "ex_cn": "我知道这个字。", "ex_py": "Wǒ zhīdào zhège zì.", "ex_en": "I know this character.", "chars": ["知", "道"], "examples": [{"level": "HSK1", "cn": "我知道这个字。", "py": "Wǒ zhīdào zhège zì.", "en": "I know this character."}, {"level": "HSK1", "cn": "你知道吗？", "py": "Nǐ zhīdào ma?", "en": "Do you know?"}, {"level": "HSK1", "cn": "我不知道答案。", "py": "Wǒ bù zhīdào dá'àn.", "en": "I don't know the answer."}, {"level": "HSK2", "cn": "直到今天他才知道事情的真相，感到非常震惊。", "py": "Zhídào jīntiān tā cái zhīdào shìqing de zhēnxiàng, gǎndào fēicháng zhènjīng.", "en": "He only found out the truth today, and was very shocked."}, {"level": "HSK2", "cn": "虽然我知道这样做不对，但当时别无选择。", "py": "Suīrán wǒ zhīdào zhèyàng zuò bú duì, dàn dāngshí bié wú xuǎnzé.", "en": "Although I knew this wasn't right, there was no other choice at the time."}]}, {"id": 316, "level": "HSK2", "chinese": "只", "pinyin": "zhǐ", "english": "only", "khmer": "តែ", "breakdown": "-", "ex_cn": "我只有一本书。", "ex_py": "Wǒ zhǐ yǒu yì běn shū.", "ex_en": "I only have one book.", "chars": ["只"], "examples": [{"level": "HSK1", "cn": "我只有一本书。", "py": "Wǒ zhǐ yǒu yì běn shū.", "en": "I only have one book."}, {"level": "HSK1", "cn": "他只喝水。", "py": "Tā zhǐ hē shuǐ.", "en": "He only drinks water."}, {"level": "HSK1", "cn": "我只想休息。", "py": "Wǒ zhǐ xiǎng xiūxi.", "en": "I only want to rest."}, {"level": "HSK2", "cn": "这次考试只有他一个人得了满分，非常厉害。", "py": "Zhè cì kǎoshì zhǐyǒu tā yí ge rén déle mǎnfēn, fēicháng lìhai.", "en": "In this exam, only he got a perfect score, that's impressive."}, {"level": "HSK2", "cn": "无论结果如何，我只希望大家都尽力了。", "py": "Wúlùn jiéguǒ rúhé, wǒ zhǐ xīwàng dàjiā dōu jìnlì le.", "en": "No matter the result, I only hope everyone tried their best."}]}, {"id": 317, "level": "HSK2", "chinese": "中间", "pinyin": "zhōngjiān", "english": "middle", "khmer": "កណ្តាល", "breakdown": "中(middle)+间(space)", "ex_cn": "他坐在中间。", "ex_py": "Tā zuò zài zhōngjiān.", "ex_en": "He sits in the middle.", "chars": ["中", "间"], "examples": [{"level": "HSK1", "cn": "他坐在中间。", "py": "Tā zuò zài zhōngjiān.", "en": "He sits in the middle."}, {"level": "HSK1", "cn": "中间那个是我。", "py": "Zhōngjiān nàge shì wǒ.", "en": "The one in the middle is me."}, {"level": "HSK1", "cn": "桌子放在中间。", "py": "Zhuōzi fàng zài zhōngjiān.", "en": "The table is placed in the middle."}, {"level": "HSK2", "cn": "会议桌的中间摆放着一束鲜花，显得很正式。", "py": "Huìyìzhuō de zhōngjiān bǎifàngzhe yí shù xiānhuā, xiǎnde hěn zhèngshì.", "en": "A bunch of flowers is placed in the middle of the meeting table, making it look formal."}, {"level": "HSK2", "cn": "两栋楼中间有一条小路，很少有人走。", "py": "Liǎng dòng lóu zhōngjiān yǒu yì tiáo xiǎolù, hěn shǎo yǒurén zǒu.", "en": "There's a small path between the two buildings, few people walk it."}]}, {"id": 318, "level": "HSK2", "chinese": "种", "pinyin": "zhǒng", "english": "kind / type", "khmer": "ប្រភេទ", "breakdown": "-", "ex_cn": "这种水果很甜。", "ex_py": "Zhè zhǒng shuǐguǒ hěn tián.", "ex_en": "This kind of fruit is sweet.", "chars": ["种"], "examples": [{"level": "HSK1", "cn": "这种水果很甜。", "py": "Zhè zhǒng shuǐguǒ hěn tián.", "en": "This kind of fruit is sweet."}, {"level": "HSK1", "cn": "我喜欢这种颜色。", "py": "Wǒ xǐhuan zhè zhǒng yánsè.", "en": "I like this kind of color."}, {"level": "HSK1", "cn": "这是一种新方法。", "py": "Zhè shì yì zhǒng xīn fāngfǎ.", "en": "This is a new kind of method."}, {"level": "HSK2", "cn": "市场上有各种各样的水果，价格也各不相同。", "py": "Shìchǎng shàng yǒu gè zhǒng gè yàng de shuǐguǒ, jiàgé yě gè bù xiāngtóng.", "en": "The market has all kinds of fruit, and the prices vary too."}, {"level": "HSK2", "cn": "这种情况以前从未发生过，大家都很担心。", "py": "Zhè zhǒng qíngkuàng yǐqián cóng wèi fāshēng guò, dàjiā dōu hěn dānxīn.", "en": "This kind of situation has never happened before, everyone is worried."}]}, {"id": 319, "level": "HSK2", "chinese": "准备", "pinyin": "zhǔnbèi", "english": "prepare", "khmer": "រៀបចំ", "breakdown": "准(allow/standard)+备(prepare)", "ex_cn": "我在准备考试。", "ex_py": "Wǒ zài zhǔnbèi kǎoshì.", "ex_en": "I am preparing for the exam.", "chars": ["准", "备"], "examples": [{"level": "HSK1", "cn": "我在准备考试。", "py": "Wǒ zài zhǔnbèi kǎoshì.", "en": "I am preparing for the exam."}, {"level": "HSK1", "cn": "妈妈在准备晚饭。", "py": "Māma zài zhǔnbèi wǎnfàn.", "en": "Mom is preparing dinner."}, {"level": "HSK1", "cn": "你准备好了吗？", "py": "Nǐ zhǔnbèi hǎo le ma?", "en": "Are you ready?"}, {"level": "HSK2", "cn": "他花了整整一个月的时间准备这次演讲。", "py": "Tā huāle zhěngzhěng yí ge yuè de shíjiān zhǔnbèi zhè cì yǎnjiǎng.", "en": "He spent a whole month preparing for this speech."}, {"level": "HSK2", "cn": "出发以前，请提前准备好所有需要的证件。", "py": "Chūfā yǐqián, qǐng tíqián zhǔnbèi hǎo suǒyǒu xūyào de zhèngjiàn.", "en": "Before departure, please prepare all the necessary documents in advance."}]}, {"id": 320, "level": "HSK2", "chinese": "自己", "pinyin": "zìjǐ", "english": "oneself", "khmer": "ខ្លួនឯង", "breakdown": "自(self)+己(self)", "ex_cn": "我自己做作业。", "ex_py": "Wǒ zìjǐ zuò zuòyè.", "ex_en": "I do homework myself.", "chars": ["自", "己"], "examples": [{"level": "HSK1", "cn": "我自己做作业。", "py": "Wǒ zìjǐ zuò zuòyè.", "en": "I do homework myself."}, {"level": "HSK1", "cn": "这是我自己的书。", "py": "Zhè shì wǒ zìjǐ de shū.", "en": "This is my own book."}, {"level": "HSK1", "cn": "你要相信自己。", "py": "Nǐ yào xiāngxìn zìjǐ.", "en": "You need to believe in yourself."}, {"level": "HSK2", "cn": "不管别人怎么说，他始终坚持自己的想法。", "py": "Bùguǎn biérén zěnme shuō, tā shǐzhōng jiānchí zìjǐ de xiǎngfǎ.", "en": "No matter what others say, he always sticks to his own opinion."}, {"level": "HSK2", "cn": "遇到困难的时候，我们应该学会自己解决问题。", "py": "Yùdào kùnnan de shíhou, wǒmen yīnggāi xuéhuì zìjǐ jiějué wèntí.", "en": "When facing difficulties, we should learn to solve problems ourselves."}]}, {"id": 321, "level": "HSK2", "chinese": "走", "pinyin": "zǒu", "english": "walk / leave", "khmer": "ដើរ / ចេញទៅ", "breakdown": "-", "ex_cn": "我们走吧。", "ex_py": "Wǒmen zǒu ba.", "ex_en": "Let's go.", "chars": ["走"], "examples": [{"level": "HSK1", "cn": "我们走吧。", "py": "Wǒmen zǒu ba.", "en": "Let's go."}, {"level": "HSK1", "cn": "我每天走路上学。", "py": "Wǒ měitiān zǒulù shàngxué.", "en": "I walk to school every day."}, {"level": "HSK1", "cn": "他已经走了。", "py": "Tā yǐjīng zǒu le.", "en": "He has already left."}, {"level": "HSK2", "cn": "他头也不回地走了，谁也没能留住他。", "py": "Tā tóu yě bù huí de zǒu le, shéi yě méi néng liúzhù tā.", "en": "He walked away without looking back, no one could keep him."}, {"level": "HSK2", "cn": "从这里走到火车站大约需要二十分钟。", 