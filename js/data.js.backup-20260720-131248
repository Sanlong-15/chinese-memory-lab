vel": "HSK1", "cn": "我下个月去中国。", "py": "Wǒ xià ge yuè qù Zhōngguó.", "en": "I'm going to China next month."}, {"level": "HSK2", "cn": "这个项目已经进行了三个月了。", "py": "Zhège xiàngmù yǐjīng jìnxíngle sān ge yuè le.", "en": "This project has been going on for three months."}, {"level": "HSK2", "cn": "每月的开销我都会仔细记录下来。", "py": "Měi yuè de kāixiāo wǒ dōu huì zǐxì jìlù xiàlai.", "en": "I carefully record my expenses every month."}]}, {"id": 141, "level": "HSK1", "chinese": "再见", "pinyin": "zàijiàn", "english": "goodbye", "khmer": "លាហើយ", "breakdown": "再(again)+见(see)", "ex_cn": "再见！明天见。", "ex_py": "Zàijiàn! Míngtiān jiàn.", "ex_en": "Goodbye! See you tomorrow.", "chars": ["再", "见"], "examples": [{"level": "HSK1", "cn": "再见！明天见。", "py": "Zàijiàn! Míngtiān jiàn.", "en": "Goodbye! See you tomorrow."}, {"level": "HSK1", "cn": "老师，再见！", "py": "Lǎoshī, zàijiàn!", "en": "Goodbye, teacher!"}, {"level": "HSK1", "cn": "我要走了，再见。", "py": "Wǒ yào zǒu le, zàijiàn.", "en": "I'm leaving, goodbye."}, {"level": "HSK2", "cn": "说了再见以后，他就开车离开了。", "py": "Shuōle zàijiàn yǐhòu, tā jiù kāichē líkāi le.", "en": "After saying goodbye, he drove away."}, {"level": "HSK2", "cn": "分别的时候，大家都依依不舍地说了再见。", "py": "Fēnbié de shíhou, dàjiā dōu yīyī bùshě de shuōle zàijiàn.", "en": "At the moment of parting, everyone reluctantly said goodbye."}]}, {"id": 142, "level": "HSK1", "chinese": "在", "pinyin": "zài", "english": "at / in / located at", "khmer": "នៅ", "breakdown": "-", "ex_cn": "我在家。", "ex_py": "Wǒ zài jiā.", "ex_en": "I am at home.", "chars": ["在"], "examples": [{"level": "HSK1", "cn": "我在家。", "py": "Wǒ zài jiā.", "en": "I am at home."}, {"level": "HSK1", "cn": "他在学校。", "py": "Tā zài xuéxiào.", "en": "He is at school."}, {"level": "HSK1", "cn": "书在桌子上。", "py": "Shū zài zhuōzi shàng.", "en": "The book is on the table."}, {"level": "HSK2", "cn": "我们的会议在下午三点举行。", "py": "Wǒmen de huìyì zài xiàwǔ sān diǎn jǔxíng.", "en": "Our meeting will be held at 3pm."}, {"level": "HSK2", "cn": "成功往往在于坚持不懈的努力。", "py": "Chénggōng wǎngwǎng zàiyú jiānchí búxiè de nǔlì.", "en": "Success often lies in persistent effort."}]}, {"id": 143, "level": "HSK1", "chinese": "怎么", "pinyin": "zěnme", "english": "how", "khmer": "តើ​ធ្វើ​ដូចម្តេច", "breakdown": "-", "ex_cn": "这个字怎么写？", "ex_py": "Zhège zì zěnme xiě?", "ex_en": "How do you write this character?", "chars": ["怎", "么"], "examples": [{"level": "HSK1", "cn": "这个字怎么写？", "py": "Zhège zì zěnme xiě?", "en": "How do you write this character?"}, {"level": "HSK1", "cn": "这个词怎么读？", "py": "Zhège cí zěnme dú?", "en": "How do you pronounce this word?"}, {"level": "HSK1", "cn": "你怎么了？", "py": "Nǐ zěnme le?", "en": "What's wrong with you?"}, {"level": "HSK2", "cn": "我不知道该怎么向他解释这件事。", "py": "Wǒ bù zhīdào gāi zěnme xiàng tā jiěshì zhè jiàn shì.", "en": "I don't know how to explain this to him."}, {"level": "HSK2", "cn": "不管别人怎么看，我都会坚持自己的想法。", "py": "Bùguǎn biéren zěnme kàn, wǒ dōu huì jiānchí zìjǐ de xiǎngfǎ.", "en": "No matter how others see it, I'll stick to my own opinion."}]}, {"id": 144, "level": "HSK1", "chinese": "怎么样", "pinyin": "zěnmeyàng", "english": "how about / how is it", "khmer": "យ៉ាងម៉េចដែរ", "breakdown": "怎么(how)+样(way/manner)", "ex_cn": "今天天气怎么样？", "ex_py": "Jīntiān tiānqì zěnmeyàng?", "ex_en": "How's the weather today?", "chars": ["怎", "么", "样"], "examples": [{"level": "HSK1", "cn": "今天天气怎么样？", "py": "Jīntiān tiānqì zěnmeyàng?", "en": "How's the weather today?"}, {"level": "HSK1", "cn": "这个主意怎么样？", "py": "Zhège zhǔyi zěnmeyàng?", "en": "How about this idea?"}, {"level": "HSK1", "cn": "你最近怎么样？", "py": "Nǐ zuìjìn zěnmeyàng?", "en": "How have you been recently?"}, {"level": "HSK2", "cn": "不管结果怎么样，我们都尽力了。", "py": "Bùguǎn jiéguǒ zěnmeyàng, wǒmen dōu jìnlì le.", "en": "No matter how the result turns out, we did our best."}, {"level": "HSK2", "cn": "你觉得这个新方案实施起来怎么样？", "py": "Nǐ juéde zhège xīn fāng'àn shíshī qǐlai zěnmeyàng?", "en": "What do you think about implementing this new plan?"}]}, {"id": 145, "level": "HSK1", "chinese": "这", "pinyin": "zhè", "english": "this", "khmer": "នេះ", "breakdown": "-", "ex_cn": "这是我的书。", "ex_py": "Zhè shì wǒ de shū.", "ex_en": "This is my book.", "chars": ["这"], "examples": [{"level": "HSK1", "cn": "这是我的书。", "py": "Zhè shì wǒ de shū.", "en": "This is my book."}, {"level": "HSK1", "cn": "这个很好吃。", "py": "Zhège hěn hǎochī.", "en": "This is delicious."}, {"level": "HSK1", "cn": "这是谁的杯子？", "py": "Zhè shì shéi de bēizi?", "en": "Whose cup is this?"}, {"level": "HSK2", "cn": "这次经历让我学到了很多东西。", "py": "Zhè cì jīnglì ràng wǒ xuédàole hěn duō dōngxi.", "en": "This experience taught me a lot."}, {"level": "HSK2", "cn": "这份工作虽然辛苦，却很有意义。", "py": "Zhè fèn gōngzuò suīrán xīnkǔ, què hěn yǒu yìyì.", "en": "This job, though tiring, is very meaningful."}]}, {"id": 146, "level": "HSK1", "chinese": "中国", "pinyin": "Zhōngguó", "english": "China", "khmer": "ប្រទេសចិន", "breakdown": "中(middle)+国(country)", "ex_cn": "他来自中国。", "ex_py": "Tā láizì Zhōngguó.", "ex_en": "He is from China.", "chars": ["中", "国"], "examples": [{"level": "HSK1", "cn": "他来自中国。", "py": "Tā láizì Zhōngguó.", "en": "He is from China."}, {"level": "HSK1", "cn": "我想去中国旅游。", "py": "Wǒ xiǎng qù Zhōngguó lǚyóu.", "en": "I want to travel to China."}, {"level": "HSK1", "cn": "中国很大。", "py": "Zhōngguó hěn dà.", "en": "China is very big."}, {"level": "HSK2", "cn": "中国有着悠久的历史和文化。", "py": "Zhōngguó yǒuzhe yōujiǔ de lìshǐ hé wénhuà.", "en": "China has a long history and culture."}, {"level": "HSK2", "cn": "越来越多的外国人开始学习中国文化。", "py": "Yuè lái yuè duō de wàiguórén kāishǐ xuéxí Zhōngguó wénhuà.", "en": "More and more foreigners are starting to learn about Chinese culture."}]}, {"id": 147, "level": "HSK1", "chinese": "中午", "pinyin": "zhōngwǔ", "english": "noon", "khmer": "ថ្ងៃត្រង់", "breakdown": "中(middle)+午(noon)", "ex_cn": "中午我们吃饭。", "ex_py": "Zhōngwǔ wǒmen chīfàn.", "ex_en": "We eat lunch at noon.", "chars": ["中", "午"], "examples": [{"level": "HSK1", "cn": "中午我们吃饭。", "py": "Zhōngwǔ wǒmen chīfàn.", "en": "We eat lunch at noon."}, {"level": "HSK1", "cn": "中午十二点见。", "py": "Zhōngwǔ shí'èr diǎn jiàn.", "en": "See you at noon, 12 o'clock."}, {"level": "HSK1", "cn": "中午我要休息。", "py": "Zhōngwǔ wǒ yào xiūxi.", "en": "I need to rest at noon."}, {"level": "HSK2", "cn": "中午的时候，餐厅总是特别拥挤。", "py": "Zhōngwǔ de shíhou, cāntīng zǒngshì tèbié yōngjǐ.", "en": "At noon, the restaurant is always especially crowded."}, {"level": "HSK2", "cn": "他习惯中午小睡一会儿，下午更有精神。", "py": "Tā xíguàn zhōngwǔ xiǎoshuì yíhuìr, xiàwǔ gèng yǒu jīngshen.", "en": "He's used to taking a short nap at noon, which gives him more energy in the afternoon."}]}, {"id": 148, "level": "HSK1", "chinese": "住", "pinyin": "zhù", "english": "live / reside", "khmer": "រស់នៅ", "breakdown": "-", "ex_cn": "我住在金边。", "ex_py": "Wǒ zhù zài Jīnbiān.", "ex_en": "I live in Phnom Penh.", "chars": ["住"], "examples": [{"level": "HSK1", "cn": "我住在金边。", "py": "Wǒ zhù zài Jīnbiān.", "en": "I live in Phnom Penh."}, {"level": "HSK1", "cn": "你住在哪儿？", "py": "Nǐ zhù zài nǎr?", "en": "Where do you live?"}, {"level": "HSK1", "cn": "他住在学校附近。", "py": "Tā zhù zài xuéxiào fùjìn.", "en": "He lives near the school."}, {"level": "HSK2", "cn": "我们在这个城市已经住了十年了。", "py": "Wǒmen zài zhège chéngshì yǐjīng zhùle shí nián le.", "en": "We've lived in this city for ten years already."}, {"level": "HSK2", "cn": "因为工作原因，他不得不搬到别的城市住。", "py": "Yīnwèi gōngzuò yuányīn, tā bùdébù bāndào bié de chéngshì zhù.", "en": "Because of work, he had to move to live in another city."}]}, {"id": 149, "level": "HSK1", "chinese": "桌子", "pinyin": "zhuōzi", "english": "table", "khmer": "តុ", "breakdown": "桌(table)+子(noun suffix)", "ex_cn": "书在桌子上。", "ex_py": "Shū zài zhuōzi shàng.", "ex_en": "The book is on the table.", "chars": ["桌", "子"], "examples": [{"level": "HSK1", "cn": "书在桌子上。", "py": "Shū zài zhuōzi shàng.", "en": "The book is on the table."}, {"level": "HSK1", "cn": "这张桌子很大。", "py": "Zhè zhāng zhuōzi hěn dà.", "en": "This table is very big."}, {"level": "HSK1", "cn": "请把杯子放在桌子上。", "py": "Qǐng bǎ bēizi fàng zài zhuōzi shàng.", "en": "Please put the cup on the table."}, {"level": "HSK2", "cn": "这张桌子是爷爷传下来的老物件。", "py": "Zhè zhāng zhuōzi shì yéye chuán xiàlai de lǎo wùjiàn.", "en": "This table is an old item passed down from grandpa."}, {"level": "HSK2", "cn": "他把所有的文件都整齐地放在桌子上。", "py": "Tā bǎ suǒyǒu de wénjiàn dōu zhěngqí de fàng zài zhuōzi shàng.", "en": "He neatly arranged all the documents on the table."}]}, {"id": 150, "level": "HSK1", "chinese": "字", "pinyin": "zì", "english": "character / word", "khmer": "អក្សរ", "breakdown": "-", "ex_cn": "这个字很难写。", "ex_py": "Zhège zì hěn nán xiě.", "ex_en": "This character is hard to write.", "chars": ["字"], "examples": [{"level": "HSK1", "cn": "这个字很难写。", "py": "Zhège zì hěn nán xiě.", "en": "This character is hard to write."}, {"level": "HSK1", "cn": "我在学写汉字。", "py": "Wǒ zài xué xiě Hànzì.", "en": "I am learning to write Chinese characters."}, {"level": "HSK1", "cn": "你认识这个字吗？", "py": "Nǐ rènshi zhège zì ma?", "en": "Do you recognize this character?"}, {"level": "HSK2", "cn": "汉字的写法虽然复杂，但很有规律。", "py": "Hànzì de xiěfǎ suīrán fùzá, dàn hěn yǒu guīlǜ.", "en": "Though Chinese characters are complex to write, they follow patterns."}, {"level": "HSK2", "cn": "每个字背后都有一个有趣的故事。", "py": "Měi ge zì bèihòu dōu yǒu yí ge yǒuqù de gùshi.", "en": "Behind every character there is an interesting story."}]}, {"id": 151, "level": "HSK1", "chinese": "昨天", "pinyin": "zuótiān", "english": "yesterday", "khmer": "ម្សិលមិញ", "breakdown": "昨(yesterday)+天(day)", "ex_cn": "昨天我很忙。", "ex_py": "Zuótiān wǒ hěn máng.", "ex_en": "I was very busy yesterday.", "chars": ["昨", "天"], "examples": [{"level": "HSK1", "cn": "昨天我很忙。", "py": "Zuótiān wǒ hěn máng.", "en": "I was very busy yesterday."}, {"level": "HSK1", "cn": "昨天天气很好。", "py": "Zuótiān tiānqì hěn hǎo.", "en": "The weather was good yesterday."}, {"level": "HSK1", "cn": "你昨天去哪儿了？", "py": "Nǐ zuótiān qù nǎr le?", "en": "Where did you go yesterday?"}, {"level": "HSK2", "cn": "昨天发生的事情，我到现在还很难忘记。", "py": "Zuótiān fāshēng de shìqing, wǒ