glish": "white sugar", "khmer": "ស្ករស", "breakdown": "白(white)+糖(sugar)", "ex_cn": "他喜欢加白糖。", "ex_py": "Tā xǐhuan jiā báitáng.", "ex_en": "He likes adding white sugar.", "chars": ["白", "糖"], "examples": [{"level": "HSK1", "cn": "他喜欢加白糖。", "py": "Tā xǐhuan jiā báitáng.", "en": "He likes adding white sugar."}, {"level": "HSK1", "cn": "请给我一点白糖。", "py": "Qǐng gěi wǒ yìdiǎn báitáng.", "en": "Please give me a little white sugar."}, {"level": "HSK1", "cn": "咖啡里加白糖。", "py": "Kāfēi lǐ jiā báitáng.", "en": "Add white sugar to the coffee."}, {"level": "HSK2", "cn": "做这道甜品需要加入适量的白糖来调味。", "py": "Zuò zhè dào tiánpǐn xūyào jiārù shìliàng de báitáng lái tiáowèi.", "en": "Making this dessert requires adding an appropriate amount of white sugar for flavor."}, {"level": "HSK2", "cn": "医生建议糖尿病患者尽量少吃白糖。", "py": "Yīshēng jiànyì tángniàobìng huànzhě jǐnliàng shǎo chī báitáng.", "en": "Doctors recommend that diabetic patients eat as little white sugar as possible."}]}, {"id": 341, "level": "L11", "chinese": "最后", "pinyin": "zuìhòu", "english": "finally / at last", "khmer": "ចុងក្រោយ", "breakdown": "最(most)+后(after)", "ex_cn": "最后加一点盐。", "ex_py": "Zuìhòu jiā yìdiǎn yán.", "ex_en": "Finally, add a little salt.", "chars": ["最", "后"], "examples": [{"level": "HSK1", "cn": "最后加一点盐。", "py": "Zuìhòu jiā yìdiǎn yán.", "en": "Finally, add a little salt."}, {"level": "HSK1", "cn": "这是最后一个问题。", "py": "Zhè shì zuìhòu yí ge wèntí.", "en": "This is the last question."}, {"level": "HSK1", "cn": "我们最后见面了。", "py": "Wǒmen zuìhòu jiànmiàn le.", "en": "We finally met."}, {"level": "HSK2", "cn": "经过三年的努力，他最后终于实现了自己的梦想。", "py": "Jīngguò sān nián de nǔlì, tā zuìhòu zhōngyú shíxiànle zìjǐ de mèngxiǎng.", "en": "After three years of effort, he finally achieved his dream."}, {"level": "HSK2", "cn": "不管过程多么艰难，我们都要坚持到最后。", "py": "Bùguǎn guòchéng duōme jiānnán, wǒmen dōu yào jiānchí dào zuìhòu.", "en": "No matter how hard the process is, we must persist to the end."}]}, {"id": 342, "level": "L11", "chinese": "盐", "pinyin": "yán", "english": "salt", "khmer": "អំបិល", "breakdown": "-", "ex_cn": "汤里的盐够了。", "ex_py": "Tāng lǐ de yán gòu le.", "ex_en": "There's enough salt in the soup.", "chars": ["盐"], "examples": [{"level": "HSK1", "cn": "汤里的盐够了。", "py": "Tāng lǐ de yán gòu le.", "en": "There's enough salt in the soup."}, {"level": "HSK1", "cn": "请加一点盐。", "py": "Qǐng jiā yìdiǎn yán.", "en": "Please add a little salt."}, {"level": "HSK1", "cn": "这个菜太咸，盐放多了。", "py": "Zhège cài tài xián, yán fàng duō le.", "en": "This dish is too salty, too much salt was added."}, {"level": "HSK2", "cn": "医生建议每天摄入的盐量不要超过六克。", "py": "Yīshēng jiànyì měitiān shèrù de yán liàng búyào chāoguò liù kè.", "en": "Doctors recommend not consuming more than six grams of salt per day."}, {"level": "HSK2", "cn": "做这道菜时，盐要最后放，才能保持食材的鲜味。", "py": "Zuò zhè dào cài shí, yán yào zuìhòu fàng, cái néng bǎochí shícái de xiānwèi.", "en": "When making this dish, add the salt last to preserve the freshness of the ingredients."}]}, {"id": 343, "level": "L11", "chinese": "尝", "pinyin": "cháng", "english": "to taste", "khmer": "ភ្លក្សរស", "breakdown": "-", "ex_cn": "你尝尝这个菜。", "ex_py": "Nǐ chángchang zhège cài.", "ex_en": "Try tasting this dish.", "chars": ["尝"], "examples": [{"level": "HSK1", "cn": "你尝尝这个菜。", "py": "Nǐ chángchang zhège cài.", "en": "Try tasting this dish."}, {"level": "HSK1", "cn": "我想尝一下。", "py": "Wǒ xiǎng cháng yíxià.", "en": "I want to try a taste."}, {"level": "HSK1", "cn": "请尝尝这个汤。", "py": "Qǐng chángchang zhège tāng.", "en": "Please try this soup."}, {"level": "HSK2", "cn": "做菜的时候，要不时地尝一尝味道够不够。", "py": "Zuòcài de shíhou, yào bùshí de cháng yi cháng wèidao gòu bu gòu.", "en": "While cooking, you should taste it now and then to check the flavor."}, {"level": "HSK2", "cn": "这是他第一次尝到失败的滋味，感到很难过。", "py": "Zhè shì tā dì yī cì chángdào shībài de zīwèi, gǎndào hěn nánguò.", "en": "This was the first time he tasted failure, and he felt very sad."}]}, {"id": 344, "level": "L11", "chinese": "嗯", "pinyin": "ńg", "english": "mm / okay", "khmer": "អឹម", "breakdown": "-", "ex_cn": "嗯，我知道了。", "ex_py": "Ńg, wǒ zhīdào le.", "ex_en": "Mm, I understand now.", "chars": ["嗯"], "examples": [{"level": "HSK1", "cn": "嗯，我知道了。", "py": "Ńg, wǒ zhīdào le.", "en": "Mm, I understand now."}, {"level": "HSK1", "cn": "嗯，好的。", "py": "Ńg, hǎo de.", "en": "Mm, okay."}, {"level": "HSK1", "cn": "嗯，没问题。", "py": "Ńg, méi wèntí.", "en": "Mm, no problem."}, {"level": "HSK2", "cn": "他嗯了一声，表示同意了我的建议。", "py": "Tā ńgle yì shēng, biǎoshì tóngyìle wǒ de jiànyì.", "en": "He gave a small 'mm', indicating he agreed with my suggestion."}, {"level": "HSK2", "cn": "听完解释，她只是嗯了一下，没有再多说什么。", "py": "Tīng wán jiěshì, tā zhǐshì ńgle yíxià, méiyǒu zài duō shuō shénme.", "en": "After hearing the explanation, she just said 'mm' and didn't say anything more."}]}, {"id": 345, "level": "L11", "chinese": "特点", "pinyin": "tèdiǎn", "english": "characteristic / feature", "khmer": "លក្ខណៈពិសេស", "breakdown": "特(special)+点(point)", "ex_cn": "这个菜的特点是酸甜。", "ex_py": "Zhège cài de tèdiǎn shì suān tián.", "ex_en": "The characteristic of this dish is sweet-and-sour.", "chars": ["特", "点"], "examples": [{"level": "HSK1", "cn": "这个菜的特点是酸甜。", "py": "Zhège cài de tèdiǎn shì suān tián.", "en": "The characteristic of this dish is sweet-and-sour."}, {"level": "HSK1", "cn": "他的特点是很认真。", "py": "Tā de tèdiǎn shì hěn rènzhēn.", "en": "His characteristic is being very serious."}, {"level": "HSK1", "cn": "每个人都有自己的特点。", "py": "Měi ge rén dōu yǒu zìjǐ de tèdiǎn.", "en": "Everyone has their own characteristics."}, {"level": "HSK2", "cn": "这个地区的建筑风格有很明显的地方特点。", "py": "Zhège dìqū de jiànzhù fēnggé yǒu hěn míngxiǎn de dìfang tèdiǎn.", "en": "This region's architectural style has very distinct local characteristics."}, {"level": "HSK2", "cn": "每种语言都有自己独特的语法特点，值得研究。", "py": "Měi zhǒng yǔyán dōu yǒu zìjǐ dútè de yǔfǎ tèdiǎn, zhíde yánjiū.", "en": "Every language has its own unique grammatical features, worth studying."}]}, {"id": 346, "level": "L11", "chinese": "闻", "p